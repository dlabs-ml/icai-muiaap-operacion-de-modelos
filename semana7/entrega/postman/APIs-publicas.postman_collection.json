{
  "info": {
    "name": "Práctica APIs Públicas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://jsonplaceholder.typicode.com"
    },
    {
      "key": "poke_url",
      "value": "https://pokeapi.co/api/v2/pokemon"
    },
    {
      "key": "pokemon_elegido",
      "value": "bulbasaur"
    },
    {
      "key": "post_creado",
      "value": "101"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Actividad aleatoria",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "https://www.boredapi.com/api/activity"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json().activity).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Pikachu",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{poke_url}}/pikachu"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json().types[0].type.name).to.eql('electric'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear post simulado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mi primer post\",\n  \"body\": \"Estoy practicando peticiones POST en Postman.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.collectionVariables.set('post_creado', String(pm.response.json().id)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json().map(x => String(x.id))).not.to.include(pm.collectionVariables.get('post_creado')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear usuario simulado en ReqRes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://reqres.in/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Carlos\",\n  \"job\": \"Tester\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json().createdAt).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cinco Pokémon",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{poke_url}}?limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { const r = pm.response.json().results; pm.expect(r).to.have.lengthOf(5); pm.collectionVariables.set('pokemon_elegido', r[0].name); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar el Pokémon elegido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{poke_url}}/{{pokemon_elegido}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Contrato del ejercicio\", () => { pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('pokemon_elegido')); });"
            ]
          }
        }
      ]
    }
  ]
}
